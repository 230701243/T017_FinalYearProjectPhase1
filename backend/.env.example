# ==========================================
# LLM Provider Environment Configuration
# ==========================================
# Set your provider API key below (never commit real secret keys to source control).
LLM_API_KEY=your_llm_api_key_here

# Optional: Custom endpoint URL (defaults to OpenAI chat completions)
LLM_API_URL=https://api.openai.com/v1/chat/completions

# Optional: Model selection (defaults to gpt-4o-mini)
LLM_MODEL=gpt-4o-mini
